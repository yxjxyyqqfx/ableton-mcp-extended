+    def _find_drum_pad_by_note(self, rack, pad_note):
+        """Return Drum Rack pad matching MIDI note, or None."""
+        try:
+            for pad in rack.drum_pads:
+                if pad.note == pad_note:
+                    return pad
+        except Exception:
+            return None
+        return None
